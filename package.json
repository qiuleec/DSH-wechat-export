{
  "name": "@local/wechat-archive",
  "version": "1.0.0",
  "private": true,
  "description": "Export this machine's WeChat chat history to HTML, CSV and TXT. · 把本机微信聊天记录导出为网页、表格与纯文本。",
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "wechat",
    "chat-export",
    "sqlcipher"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "README.md",
    "LICENSE",
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "lib/*.js",
    "validate-schema.mjs",
    "bin/wx_key.dll",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  }
}
